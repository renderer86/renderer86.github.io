{% assign author = site.data.authors[include.author] %}
{% assign author2 = false %}
{% if include.author2 %}
  {% assign author2 = site.data.authors[include.author2] %}
{% endif %}
<div class="post-info">
  {%- if author.url -%}<a href="{{ author.url | relative_url }}" target="_blank" rel="noopener">{%- endif -%}
    {% if author.avatar  %}
      <img alt="Author's avatar" src="{{ author.avatar | relative_url }}">
    {% endif %}
    {% if author2 != false %}
      {% if author2.avatar %}
        <img alt="Author2's avatar" src="{{ author2.avatar | relative_url }}">
      {% endif %}
    {% endif %}
    <div>
      <p class="meta">
        {% if author.name %}{{ author.name }}{% if author2 != false %}, {{ author2.name }}{% endif %}{% endif %}
      </p>
    </div>
  {%- if author.url -%}</a>{%- endif -%}
</div>
